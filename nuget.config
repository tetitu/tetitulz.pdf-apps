<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pin the package sources explicitly. <clear/> drops any feed inherited from a machine- or
    user-level NuGet.config, so a restore resolves the same packages on every machine and in CI.
    This repo ships cryptography (signing, encryption), which makes dependency-substitution a
    risk worth closing deliberately rather than relying on ambient configuration.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
