<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CompressPdf</RootNamespace>
    <AssemblyName>CompressPdf</AssemblyName>
    <Description>A minimal demo: make a PDF smaller with the optimizer's Lossless, Balanced and Aggressive presets, and check what each kept.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The optimizer. -->
    <ProjectReference Include="..\..\lib\tetitulz.pdf\src\plugins\Tetitulz.Pdf.Plugins.Maintenance\Tetitulz.Pdf.Plugins.Maintenance.csproj" />
    <!-- The sample input (images to PDF), page counts and text for the checks; SkiaSharp comes with it. -->
    <ProjectReference Include="..\..\lib\tetitulz.pdf\src\tetitulz.pdf\Tetitulz.Pdf.Base\Tetitulz.Pdf.Base.csproj" />
  </ItemGroup>

</Project>
